# Hugging Face Access Token (for fetching models if needed)
HF_TOKEN=

# LLM / VLM Configuration
LLM_PROVIDER=local        # local | anthropic | gemini | openai
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Execution Flags
OFFLINE=1                 # 1 = never call external APIs, use cache + local models
USE_MCP=1                 # 0 = in-process tool calls, 1 = stdio MCP server
DEVICE=auto               # auto | cpu | cuda | mps

# Paths
LLM_CACHE_DIR=data/cache
MODELS_DIR=models
DATA_DIR=data
