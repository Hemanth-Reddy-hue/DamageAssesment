{
  "$defs": {
    "AdjacencyConnection": {
      "description": "Doorway connection linking two rooms.",
      "properties": {
        "from_room": {
          "title": "From Room",
          "type": "string"
        },
        "to_room": {
          "title": "To Room",
          "type": "string"
        },
        "opening_id": {
          "title": "Opening Id",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "from_room",
        "to_room",
        "opening_id"
      ],
      "title": "AdjacencyConnection",
      "type": "object"
    },
    "ConcealedFlag": {
      "description": "Deterministic concealed-damage flag.",
      "properties": {
        "flag_id": {
          "title": "Flag Id",
          "type": "string"
        },
        "rule_id": {
          "description": "Rule ID that fired (e.g. RULE_CEIL_WET_01)",
          "title": "Rule Id",
          "type": "string"
        },
        "description": {
          "description": "Explanation of suspected concealed damage",
          "title": "Description",
          "type": "string"
        },
        "trigger_evidence": {
          "description": "List of observed evidence items that triggered rule",
          "items": {
            "type": "string"
          },
          "title": "Trigger Evidence",
          "type": "array"
        },
        "recommended_action": {
          "default": "Inspect cavity / moisture meter probe",
          "title": "Recommended Action",
          "type": "string"
        }
      },
      "required": [
        "flag_id",
        "rule_id",
        "description"
      ],
      "title": "ConcealedFlag",
      "type": "object"
    },
    "DamageRegion": {
      "description": "Identified surface damage region.",
      "properties": {
        "damage_id": {
          "title": "Damage Id",
          "type": "string"
        },
        "surface_id": {
          "description": "ID of wall, floor, or ceiling surface",
          "title": "Surface Id",
          "type": "string"
        },
        "damage_class": {
          "description": "e.g. water_stain, crack, mold, impact",
          "title": "Damage Class",
          "type": "string"
        },
        "severity": {
          "default": "minor",
          "enum": [
            "minor",
            "moderate",
            "severe"
          ],
          "title": "Severity",
          "type": "string"
        },
        "extent_metric": {
          "$ref": "#/$defs/Interval",
          "description": "Metric extent (area m^2 or crack length m) with interval"
        },
        "bounding_box_2d": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "2D bbox [ymin, xmin, ymax, xmax] in source image",
          "title": "Bounding Box 2D"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "damage_id",
        "surface_id",
        "damage_class",
        "extent_metric"
      ],
      "title": "DamageRegion",
      "type": "object"
    },
    "Interval": {
      "description": "Calibrated confidence interval for a metric measurement.",
      "properties": {
        "value": {
          "description": "Estimated nominal value in metric units (meters or m^2)",
          "title": "Value",
          "type": "number"
        },
        "lo": {
          "description": "Lower bound of confidence interval",
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "description": "Upper bound of confidence interval",
          "title": "Hi",
          "type": "number"
        },
        "confidence_level": {
          "default": 0.9,
          "description": "Nominal confidence level, e.g. 0.90 for 90%",
          "title": "Confidence Level",
          "type": "number"
        },
        "method": {
          "default": "conformal",
          "description": "Interval estimation method",
          "title": "Method",
          "type": "string"
        },
        "tier": {
          "description": "Input tier used: photo, video, or lidar",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "value",
        "lo",
        "hi",
        "tier"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Opening": {
      "description": "An architectural opening: door, window, or passageway.",
      "properties": {
        "opening_id": {
          "title": "Opening Id",
          "type": "string"
        },
        "wall_id": {
          "title": "Wall Id",
          "type": "string"
        },
        "type": {
          "default": "door",
          "enum": [
            "door",
            "window",
            "passageway"
          ],
          "title": "Type",
          "type": "string"
        },
        "width": {
          "$ref": "#/$defs/Interval",
          "description": "Width with calibrated interval"
        },
        "height": {
          "$ref": "#/$defs/Interval",
          "description": "Height with calibrated interval"
        },
        "sill_height": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sill height from floor"
        },
        "position": {
          "description": "3D center coordinate [x, y, z]",
          "items": {
            "type": "number"
          },
          "title": "Position",
          "type": "array"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "opening_id",
        "wall_id",
        "width",
        "height"
      ],
      "title": "Opening",
      "type": "object"
    },
    "QAReport": {
      "description": "Critic and validation report.",
      "properties": {
        "passed": {
          "default": true,
          "title": "Passed",
          "type": "boolean"
        },
        "checks_run": {
          "items": {
            "type": "string"
          },
          "title": "Checks Run",
          "type": "array"
        },
        "failed_checks": {
          "items": {
            "type": "string"
          },
          "title": "Failed Checks",
          "type": "array"
        },
        "adjustments_made": {
          "items": {
            "type": "string"
          },
          "title": "Adjustments Made",
          "type": "array"
        },
        "overall_confidence": {
          "default": 1.0,
          "title": "Overall Confidence",
          "type": "number"
        }
      },
      "title": "QAReport",
      "type": "object"
    },
    "RoomGeometry": {
      "description": "Complete geometrical reconstruction of a single room.",
      "properties": {
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "room_name": {
          "title": "Room Name",
          "type": "string"
        },
        "ceiling_height": {
          "$ref": "#/$defs/Interval",
          "description": "Room ceiling height with interval"
        },
        "floor_area": {
          "$ref": "#/$defs/Interval",
          "description": "Floor area in m^2 with interval"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/WallSegment"
          },
          "title": "Walls",
          "type": "array"
        },
        "floor_polygon": {
          "description": "Ordered boundary vertices [[x, y], ...]",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Floor Polygon",
          "type": "array"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "is_rectilinear": {
          "default": true,
          "description": "Whether Manhattan assumption holds",
          "title": "Is Rectilinear",
          "type": "boolean"
        },
        "provenance": {
          "default": "measured",
          "description": "Data provenance tracking",
          "enum": [
            "measured",
            "fallback",
            "bbox",
            "prior",
            "not_observed",
            "synthetic"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "transform_to_plan": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "4x4 transform to global plan coordinates",
          "title": "Transform To Plan"
        }
      },
      "required": [
        "room_id",
        "room_name",
        "ceiling_height",
        "floor_area"
      ],
      "title": "RoomGeometry",
      "type": "object"
    },
    "ScopeItem": {
      "description": "Repair scope line item keyed to a surface.",
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "damage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Damage Id"
        },
        "item_description": {
          "title": "Item Description",
          "type": "string"
        },
        "unit": {
          "description": "Measurement unit, e.g. m^2, m, ea",
          "title": "Unit",
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/Interval",
          "description": "Quantity with interval propagated from damage extent"
        },
        "unit_cost_est": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Cost Est"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "surface_id",
        "item_description",
        "unit",
        "quantity"
      ],
      "title": "ScopeItem",
      "type": "object"
    },
    "StitchedPlan": {
      "description": "Whole-property stitched floor plan.",
      "properties": {
        "rooms": {
          "items": {
            "type": "string"
          },
          "title": "Rooms",
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/AdjacencyConnection"
          },
          "title": "Connections",
          "type": "array"
        },
        "total_footprint_area": {
          "$ref": "#/$defs/Interval",
          "description": "Total footprint area with interval"
        },
        "footprint_polygon": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Footprint Polygon",
          "type": "array"
        },
        "drift_correction_applied": {
          "default": true,
          "title": "Drift Correction Applied",
          "type": "boolean"
        }
      },
      "required": [
        "total_footprint_area"
      ],
      "title": "StitchedPlan",
      "type": "object"
    },
    "WallSegment": {
      "description": "A planar wall segment in room-local or plan coordinates.",
      "properties": {
        "wall_id": {
          "title": "Wall Id",
          "type": "string"
        },
        "start": {
          "description": "Wall start point [x, y] or [x, y, z]",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Start",
          "type": "array"
        },
        "end": {
          "description": "Wall end point [x, y] or [x, y, z]",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "End",
          "type": "array"
        },
        "length": {
          "$ref": "#/$defs/Interval",
          "description": "Wall length with confidence interval"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "wall_id",
        "start",
        "end",
        "length"
      ],
      "title": "WallSegment",
      "type": "object"
    }
  },
  "description": "Complete shared state across all nodes in AreaMap LangGraph.",
  "properties": {
    "capture_path": {
      "description": "Path to capture data",
      "title": "Capture Path",
      "type": "string"
    },
    "tier": {
      "anyOf": [
        {
          "enum": [
            "photo",
            "video",
            "lidar"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier"
    },
    "device_meta": {
      "additionalProperties": true,
      "title": "Device Meta",
      "type": "object"
    },
    "rooms": {
      "items": {
        "type": "string"
      },
      "title": "Rooms",
      "type": "array"
    },
    "point_clouds": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "room_id -> point cloud artifact path",
      "title": "Point Clouds",
      "type": "object"
    },
    "room_geometry": {
      "additionalProperties": {
        "$ref": "#/$defs/RoomGeometry"
      },
      "title": "Room Geometry",
      "type": "object"
    },
    "openings": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Opening"
        },
        "type": "array"
      },
      "title": "Openings",
      "type": "object"
    },
    "doorway_transitions": {
      "description": "Transition edges between rooms",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Doorway Transitions",
      "type": "array"
    },
    "stitched_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/StitchedPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intervals": {
      "additionalProperties": {
        "$ref": "#/$defs/Interval"
      },
      "title": "Intervals",
      "type": "object"
    },
    "damage": {
      "items": {
        "$ref": "#/$defs/DamageRegion"
      },
      "title": "Damage",
      "type": "array"
    },
    "concealed_flags": {
      "items": {
        "$ref": "#/$defs/ConcealedFlag"
      },
      "title": "Concealed Flags",
      "type": "array"
    },
    "scope_items": {
      "items": {
        "$ref": "#/$defs/ScopeItem"
      },
      "title": "Scope Items",
      "type": "array"
    },
    "qa_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/QAReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "output_dir": {
      "default": "out",
      "title": "Output Dir",
      "type": "string"
    }
  },
  "required": [
    "capture_path"
  ],
  "title": "CaptureState",
  "type": "object"
}